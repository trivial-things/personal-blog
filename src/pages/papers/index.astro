---
import { getCollection } from 'astro:content';

const papers = await getCollection('papers');
papers.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = import.meta.env.BASE_URL;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Papers | Academic Digital Garden</title>
  <meta name="description" content="论文阅读笔记与技术思考。" />
  <style>
    :root {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #292b25;
      background: #faf9f6;
      font-synthesis: none;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(900px, calc(100% - 40px));
      margin: 0 auto;
    }

    header {
      border-bottom: 1px solid #e8e6df;
    }

    nav {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      font-family: Georgia, serif;
      font-size: 20px;
      font-weight: 600;
    }

    .back {
      color: #77796e;
      font-size: 14px;
    }

    main {
      padding: 76px 0 100px;
    }

    .eyebrow {
      color: #858675;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      margin: 12px 0;
      font-family: Georgia, serif;
      font-size: clamp(38px, 6vw, 54px);
      font-weight: 500;
      letter-spacing: -1.5px;
    }

    .intro {
      color: #77796e;
      margin-bottom: 48px;
    }

    .paper {
      padding: 27px 0;
      border-top: 1px solid #e8e6df;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      color: #858675;
      font-size: 13px;
    }

    h2 {
      margin: 10px 0 6px;
      font-family: Georgia, serif;
      font-size: 25px;
      font-weight: 500;
    }

    .paper-link:hover h2 {
      color: #78815b;
    }

    .paper-name {
      color: #77796e;
      font-size: 14px;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 15px;
    }

    .tag {
      padding: 3px 10px;
      border: 1px solid #e5e3db;
      border-radius: 20px;
      color: #77796e;
      font-size: 12px;
    }

    footer {
      padding: 24px 0;
      border-top: 1px solid #e8e6df;
      color: #99998e;
      font-size: 13px;
    }

    /* Dark mode */
    :global(body.dark) {
      color: #e8e6df;
      background: #20211e;
    }

    :global(body.dark) header,
    :global(body.dark) .paper,
    :global(body.dark) footer {
      border-color: #3a3b35;
    }

    :global(body.dark) .back,
    :global(body.dark) .intro,
    :global(body.dark) .paper-name,
    :global(body.dark) .meta,
    :global(body.dark) .tag,
    :global(body.dark) footer {
      color: #aaa99d;
    }

    :global(body.dark) .tag {
      border-color: #3a3b35;
    }

    :global(body.dark) .paper-link:hover h2 {
      color: #aeb991;
    }
    @media (max-width: 600px) {
      main { padding-top: 52px; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="container">
      <a class="brand" href={base}>Personal Blog</a>
      <a class="back" href={base}>← Back to Home</a>
    </nav>
  </header>

  <main class="container">
    <div class="eyebrow">Knowledge Garden / Papers</div>
    <h1>Paper Notes</h1>
    <p class="intro">
      Reading notes, technical explorations and thoughts on research papers.
    </p>

    {papers.map((paper) => (
      <article class="paper">
        <a class="paper-link" href={`${base}papers/${paper.id}/`}>
          <div class="meta">
            <span>{dateFormatter.format(paper.data.date)}</span>
            <span>{paper.data.venue}</span>
          </div>
          <h2>{paper.data.title}</h2>
          <div class="paper-name">{paper.data.paper}</div>
        </a>

        <div class="tags">
          {paper.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </main>

  <footer>
    <div class="container">Academic Digital Garden</div>
  </footer>

  <script>
    const savedTheme = localStorage.getItem('theme');
    document.body.classList.toggle('dark', savedTheme === 'dark');
  </script>
</body>
</html>
