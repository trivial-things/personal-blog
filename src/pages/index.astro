---
const base = import.meta.env.BASE_URL;

const recentPapers = [
  {
    date: 'November 21, 2026',
    venue: 'CVPR 2016',
    title: 'ResNet：一个加法为什么能拯救深网络',
    paper: 'Deep Residual Learning for Image Recognition',
    href: `${base}papers/2026-11-21-resnet/`,
  },
  {
    date: 'November 18, 2026',
    venue: 'NeurIPS 2012',
    title: 'AlexNet：一张图走完的前向数据流',
    paper: 'ImageNet Classification with Deep Convolutional Neural Networks',
    href: `${base}papers/2026-11-18-alexnet/`,
  },
];

const gardenSections = [
  {
    number: '01',
    label: 'Explore',
    title: 'Explore',
    description: 'Research interests, learning paths and ideas worth exploring.',
    href: `${base}explore/`,
  },
  {
    number: '02',
    label: 'Papers',
    title: 'Papers',
    description: 'Reading notes and reflections on research papers.',
    href: `${base}papers/`,
  },
  {
    number: '03',
    label: 'Technical',
    title: 'Technical',
    description: 'Programming, tools and technical explorations.',
    href: `${base}explore/current/`,
  },
  {
    number: '04',
    label: 'Learning',
    title: 'Learning',
    description: 'Courses, concepts and knowledge notes.',
    href: `${base}explore/journey/`,
  },
  {
    number: '05',
    label: 'Projects',
    title: 'Projects',
    description: 'Things I build while learning and experimenting.',
    href: `${base}explore/current/`,
  },
  {
    number: '06',
    label: 'Journal',
    title: 'Journal',
    description: 'Personal essays, reflections and thoughts in progress.',
    href: `${base}explore/notes/`,
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="A place to think, learn and explore — an academic digital garden for research, learning and ideas." />
  <title>Personal Blog | A place to think, learn and explore</title>
  <style>
    :root {
      --bg: #faf9f6;
      --surface: #f3f1eb;
      --text: #292b25;
      --muted: #77796e;
      --soft: #99998e;
      --accent: #78815b;
      --accent-light: #a0a58a;
      --line: #e8e6df;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text);
      background: var(--bg);
      font-synthesis: none;
      scroll-behavior: smooth;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      line-height: 1.7;
      background: var(--bg);
      color: var(--text);
      transition: background .25s, color .25s;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    .container { width: min(1080px, calc(100% - 48px)); margin: 0 auto; }

    /* Full-screen photographic opening */
    .hero-shell {
      position: relative;
      min-height: 100svh;
      color: #f7f7f1;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      background: #333d3d;
      overflow: hidden;
    }
    .hero-shell::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -2;
      background-image: var(--hero-image);
      background-size: cover;
      background-position: center 52%;
      transform: scale(1.01);
    }
    .hero-shell::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(90deg, rgba(17, 25, 27, .70) 0%, rgba(17, 25, 27, .48) 44%, rgba(17, 25, 27, .12) 100%),
        linear-gradient(0deg, rgba(15, 21, 22, .32), transparent 48%);
    }
    .site-header { border-bottom: 1px solid rgba(255,255,255,.18); }
    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .brand {
      color: #fff;
      font-family: Georgia, serif;
      font-size: 21px;
      font-weight: 600;
      white-space: nowrap;
      letter-spacing: -.3px;
    }
    .nav-right { display: flex; align-items: center; gap: 27px; }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 26px;
      color: rgba(255,255,255,.82);
      font-size: 13px;
    }
    .nav-links a { transition: color .2s; }
    .nav-links a:hover { color: #fff; }
    .theme-toggle {
      width: 34px;
      height: 34px;
      border: 1px solid rgba(255,255,255,.48);
      border-radius: 50%;
      background: transparent;
      color: #fff;
      font-size: 17px;
      cursor: pointer;
    }
    .hero-content {
      width: min(1080px, calc(100% - 48px));
      margin: auto;
      padding: 90px 0 112px;
    }
    .eyebrow {
      color: rgba(255,255,255,.78);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }
    h1 {
      max-width: 780px;
      margin: 24px 0 20px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(48px, 7.3vw, 82px);
      line-height: 1.08;
      font-weight: 400;
      letter-spacing: -2.7px;
      text-wrap: balance;
    }
    .hero-subtitle {
      margin: 0;
      color: rgba(255,255,255,.92);
      font-family: Georgia, "Songti SC", "SimSun", serif;
      font-size: clamp(19px, 2.4vw, 25px);
      letter-spacing: 2px;
    }
    .hero-description {
      max-width: 550px;
      margin: 22px 0 0;
      color: rgba(255,255,255,.78);
      font-size: 14px;
      line-height: 1.95;
    }
    .hero-link {
      display: inline-flex;
      align-items: center;
      gap: 13px;
      margin-top: 34px;
      padding-bottom: 6px;
      border-bottom: 1px solid rgba(255,255,255,.65);
      color: #fff;
      font-size: 12px;
      letter-spacing: 1.2px;
      transition: gap .2s;
    }
    .hero-link:hover { gap: 19px; }

    main { padding-bottom: 78px; }
    section { padding: 76px 0; border-bottom: 1px solid var(--line); }
    .section-heading {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 32px;
    }
    .section-kicker {
      display: block;
      margin-bottom: 8px;
      color: var(--accent);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    h2 {
      margin: 0;
      font-family: Georgia, serif;
      font-size: 32px;
      font-weight: 400;
      letter-spacing: -.5px;
    }
    .section-note { color: var(--soft); font-size: 12px; }

    .garden-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .garden-card {
      display: block;
      min-height: 180px;
      padding: 24px 23px;
      border: 1px solid var(--line);
      border-radius: 4px;
      transition: border-color .2s, transform .2s, background .2s;
    }
    .garden-card:hover {
      border-color: var(--accent-light);
      transform: translateY(-3px);
      background: rgba(120,129,91,.035);
    }
    .card-number {
      color: var(--accent-light);
      font-family: Georgia, serif;
      font-size: 13px;
    }
    .garden-card h3 {
      margin: 17px 0 7px;
      font-family: Georgia, serif;
      font-size: 22px;
      font-weight: 400;
    }
    .garden-card p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }

    .paper-list { border-top: 1px solid var(--line); }
    .paper-item {
      display: block;
      padding: 23px 0;
      border-bottom: 1px solid var(--line);
    }
    .paper-item:hover h3 { color: var(--accent); }
    .paper-meta { display: flex; flex-wrap: wrap; gap: 12px; color: var(--soft); font-size: 11px; }
    .paper-item h3 {
      margin: 8px 0 4px;
      font-family: Georgia, serif;
      font-size: 23px;
      font-weight: 400;
      transition: color .2s;
    }
    .paper-name { color: var(--muted); font-size: 12px; }
    .text-link { color: var(--accent); font-size: 12px; white-space: nowrap; }

    .about-row {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 40px;
    }
    .about-content {
      max-width: 690px;
      color: var(--muted);
      font-size: 14px;
      line-height: 2;
    }
    .about-content p { margin: 0 0 12px; }
    .about-more {
      display: inline-block;
      margin-top: 9px;
      color: var(--accent);
      font-size: 12px;
      border-bottom: 1px solid var(--accent-light);
    }
    footer { padding: 27px 0 34px; color: var(--soft); font-size: 11px; }
    .footer-inner { display: flex; justify-content: space-between; gap: 20px; }

    /* Dark mode is kept compatible with the site's existing theme preference. */
    body.dark { --bg: #20221e; --surface: #292c25; --text: #e8e7df; --muted: #a4a697; --soft: #858879; --accent: #a6ae83; --accent-light: #a6ae83; --line: #3b3e35; }
    body.dark .garden-card:hover { background: rgba(166,174,131,.05); }
    body.dark .hero-shell { color: #f7f7f1; }

    @media (max-width: 760px) {
      .nav-right { gap: 14px; }
      .nav-links { gap: 15px; }
      .hero-content { padding: 80px 0 95px; }
      h1 { font-size: clamp(46px, 9vw, 68px); }
      .garden-grid { grid-template-columns: repeat(2, 1fr); }
      .about-row { grid-template-columns: 1fr; gap: 18px; }
      section { padding: 62px 0; }
    }
    @media (max-width: 520px) {
      .container, .hero-content { width: calc(100% - 38px); }
      .nav { min-height: 68px; }
      .brand { font-size: 18px; }
      .nav-links { gap: 11px; font-size: 11px; }
      .nav-right { gap: 8px; }
      .theme-toggle { width: 30px; height: 30px; }
      .hero-shell::after {
        background: linear-gradient(90deg, rgba(17,25,27,.72), rgba(17,25,27,.40)),
                    linear-gradient(0deg, rgba(15,21,22,.28), transparent 55%);
      }
      .hero-content { padding: 75px 0 86px; }
      h1 { font-size: clamp(43px, 11vw, 58px); letter-spacing: -1.8px; }
      .hero-description { font-size: 13px; }
      .section-heading { align-items: flex-start; flex-direction: column; gap: 9px; }
      h2 { font-size: 29px; }
      .garden-grid { grid-template-columns: 1fr; }
      .garden-card { min-height: 145px; }
      .paper-item h3 { font-size: 20px; }
      .footer-inner { flex-direction: column; gap: 5px; }
    }
  </style>
</head>

<body>
  <div class="hero-shell" style={`--hero-image: url("${base}images/home-hero.jpg")`}>
    <header class="site-header">
      <nav class="container nav">
        <a class="brand" href={base}>Personal Blog</a>
        <div class="nav-right">
          <div class="nav-links">
            <a href={base}>Home</a>
            <a href={`${base}explore/`}>Explore</a>
            <a href={`${base}papers/`}>Papers</a>
            <a href={`${base}about/`}>About</a>
          </div>
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode">☾</button>
        </div>
      </nav>
    </header>

    <div class="hero-content">
      <div class="eyebrow">Academic Digital Garden</div>
      <h1>A place to think,<br />learn and explore</h1>
      <p class="hero-subtitle">让知识生长，让思考留下</p>
      <p class="hero-description">
        A personal space for collecting ideas, reading research, exploring technology
        and documenting the process of learning.
      </p>
      <a class="hero-link" href={`${base}explore/`}>STEP INTO THE GARDEN <span>→</span></a>
    </div>
  </div>

  <main>
    <div class="container">
      <section id="garden">
        <div class="section-heading">
          <div>
            <span class="section-kicker">A growing collection</span>
            <h2>Explore the garden</h2>
          </div>
          <span class="section-note">Different paths, shared curiosity</span>
        </div>

        <div class="garden-grid">
          {gardenSections.map((item) => (
            <a class="garden-card" href={item.href}>
              <span class="card-number">{item.number} / {item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </a>
          ))}
        </div>
      </section>

      <section id="recent">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Reading & reflection</span>
            <h2>Recently explored</h2>
          </div>
          <a class="text-link" href={`${base}papers/`}>View all papers →</a>
        </div>

        <div class="paper-list">
          {recentPapers.map((paper) => (
            <a class="paper-item" href={paper.href}>
              <div class="paper-meta">
                <span>{paper.date}</span>
                <span>{paper.venue}</span>
              </div>
              <h3>{paper.title}</h3>
              <div class="paper-name">{paper.paper}</div>
            </a>
          ))}
        </div>
      </section>

      <section id="about">
        <div class="section-heading">
          <div>
            <span class="section-kicker">A little introduction</span>
            <h2>About this space</h2>
          </div>
        </div>
        <div class="about-row">
          <div class="about-content">
            <p>
              This website is my personal knowledge garden — a place to organize what I learn,
              record what I think, and keep track of questions worth exploring.
            </p>
            <p>
              I am an undergraduate student in Artificial Intelligence at Xi’an Jiaotong University.
              My current interests include computer vision, natural language processing and 3D vision.
              I am also curious about embodied AI and robotics, and continue to explore where these
              fields may lead.
            </p>
            <p>
              I believe understanding grows through reading, writing, experimentation and reflection.
              This site is a record of that ongoing process.
            </p>
          </div>
          <a class="about-more" href={`${base}about/`}>More about me ↗</a>
        </div>
      </section>
    </div>
  </main>

  <footer>
    <div class="container footer-inner">
      <span>Academic Digital Garden</span>
      <span>Built with curiosity and a love of learning</span>
    </div>
  </footer>

  <script is:inline>
    const themeToggle = document.querySelector('#theme-toggle');
    const savedTheme = localStorage.getItem('theme');
    const isDark = savedTheme === 'dark';

    document.body.classList.toggle('dark', isDark);

    if (themeToggle) {
      themeToggle.textContent = isDark ? '☀' : '☾';
      themeToggle.addEventListener('click', () => {
        const dark = document.body.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
        themeToggle.textContent = dark ? '☀' : '☾';
      });
    }
  </script>
</body>
</html>
